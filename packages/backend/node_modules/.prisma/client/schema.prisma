generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                    String                 @id @default(uuid())
  name                  String
  domain                String?                @unique
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  users                 User[]
  auditLogs             AuditLog[]
  accounts              Account[]
  journalEntries        JournalEntry[]
  journalLines          JournalLine[]
  departments           Department[]
  employees             Employee[]
  leaveRequests         LeaveRequest[]
  leaveBalances         LeaveBalance[]
  vendors               Vendor[]
  products              Product[]
  inventory             Inventory[]
  inventoryTransactions InventoryTransaction[]
  purchaseOrders        PurchaseOrder[]
  purchaseOrderLines    PurchaseOrderLine[]
  notifications         Notification[]
  projects              Project[]
  tasks                 Task[]
  milestones            Milestone[]
  projectBudgets        ProjectBudget[]
  payrollRuns           PayrollRun[]
  payslips              Payslip[]
  taxSlabs              TaxSlab[]
  webhookSubscriptions  WebhookSubscription[]
  webhookDeliveries     WebhookDelivery[]
  reports               Report[]
  skuHistory            SkuHistory[]
  sequences             Sequence[]

  @@map("tenants")
}

model SkuHistory {
  id        String   @id @default(uuid())
  sku       String
  quantity  Float
  date      DateTime
  tenantId  String   @map("tenant_id")
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([sku, tenantId, date])
  @@map("sku_history")
}

model Sequence {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String // e.g., "journal_entry"
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@map("sequences")
}

// Existing Tenant updates to include relations

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  firstName    String?  @map("first_name")
  lastName     String?  @map("last_name")
  isActive     Boolean  @default(true)
  tenantId     String   @map("tenant_id")
  roleId       String   @map("role_id")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id])
  role                   Role                    @relation(fields: [roleId], references: [id])
  auditLogs              AuditLog[]
  journalEntries         JournalEntry[]
  inventoryTransactions  InventoryTransaction[]
  purchaseOrders         PurchaseOrder[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  createdProjects        Project[]
  assignedTasks          Task[]

  @@unique([email, tenantId])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions Json     @default("[]")
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@map("roles")
}

model AuditLog {
  id           String   @id @default(uuid())
  action       String
  entityType   String   @map("entity_type")
  entityId     String?  @map("entity_id")
  oldValue     Json?    @map("old_value")
  newValue     Json?    @map("new_value")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  tenantId     String   @map("tenant_id")
  userId       String   @map("user_id")
  hash         String?
  previousHash String?  @map("previous_hash")
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// Finance Ledger Models

model Currency {
  id        String   @id @default(uuid())
  code      String   @unique // ISO 4217 code, e.g., USD, EUR
  name      String
  symbol    String?
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true)
  tenantId  String?  @map("tenant_id")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fromExchangeRates ExchangeRate[] @relation("FromExchangeRate")
  toExchangeRates   ExchangeRate[] @relation("ToExchangeRate")
  journalLines      JournalLine[]

  @@map("currencies")
}

model ExchangeRate {
  id             String   @id @default(uuid())
  fromCurrencyId String   @map("from_currency_id")
  toCurrencyId   String   @map("to_currency_id")
  rate           Decimal  @db.Decimal(18, 6)
  effectiveDate  DateTime @default(now()) @map("effective_date")
  isActive       Boolean  @default(true)
  tenantId       String?  @map("tenant_id")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  fromCurrency Currency @relation("FromExchangeRate", fields: [fromCurrencyId], references: [id])
  toCurrency   Currency @relation("ToExchangeRate", fields: [toCurrencyId], references: [id])

  @@unique([fromCurrencyId, toCurrencyId, effectiveDate])
  @@index([fromCurrencyId, toCurrencyId])
  @@map("exchange_rates")
}

model Account {
  id          String      @id @default(uuid())
  code        String // Account number, e.g., 1000, 1100
  name        String
  description String?
  type        AccountType
  balance     Decimal     @default(0) @db.Decimal(18, 2)
  isActive    Boolean     @default(true)
  parentId    String?     @map("parent_id")
  tenantId    String      @map("tenant_id")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  parent       Account?      @relation("AccountHierarchy", fields: [parentId], references: [id])
  children     Account[]     @relation("AccountHierarchy")
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  journalLines JournalLine[]

  @@unique([code, tenantId])
  @@index([tenantId, type])
  @@map("accounts")
}

enum AccountType {
  ASSET     @map("asset")
  LIABILITY @map("liability")
  EQUITY    @map("equity")
  REVENUE   @map("revenue")
  EXPENSE   @map("expense")
}

model JournalEntry {
  id          String      @id @default(uuid())
  entryNumber String      @unique // Auto-generated entry number
  date        DateTime    @default(now())
  description String
  status      EntryStatus @default(DRAFT)
  tenantId    String      @map("tenant_id")
  createdById String      @map("created_by_id")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  lines     JournalLine[]
  createdBy User          @relation(fields: [createdById], references: [id])
  tenant    Tenant        @relation(fields: [tenantId], references: [id])

  @@index([tenantId, date])
  @@index([tenantId, status])
  @@map("journal_entries")
}

enum EntryStatus {
  DRAFT  @map("draft")
  POSTED @map("posted")
  VOIDED @map("voided")
}

model JournalLine {
  id             String   @id @default(uuid())
  journalEntryId String   @map("journal_entry_id")
  accountId      String   @map("account_id")
  debit          Decimal? @db.Decimal(18, 2)
  credit         Decimal? @db.Decimal(18, 2)
  description    String?
  tenantId       String   @map("tenant_id")
  currencyId     String?  @map("currency_id")
  exchangeRate   Decimal? @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])
  currency     Currency?    @relation(fields: [currencyId], references: [id])
  tenant       Tenant       @relation(fields: [tenantId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@index([tenantId, accountId])
  @@map("journal_lines")
}

// HR & Employee Models

model Department {
  id          String   @id @default(uuid())
  name        String
  description String?
  managerId   String?  @map("manager_id")
  isActive    Boolean  @default(true)
  tenantId    String   @map("tenant_id")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([name, tenantId])
  @@map("departments")
}

model Employee {
  id           String   @id @default(uuid())
  employeeCode String   @unique @map("employee_code")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  email        String
  phone        String?
  hireDate     DateTime @default(now()) @map("hire_date")
  position     String?
  salary       Decimal? @db.Decimal(18, 2)
  isActive     Boolean  @default(true)
  departmentId String?  @map("department_id")
  tenantId     String   @map("tenant_id")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department    Department?    @relation(fields: [departmentId], references: [id])
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]
  payslips      Payslip[]

  @@unique([employeeCode, tenantId])
  @@index([departmentId])
  @@index([tenantId])
  @@map("employees")
}

model LeaveRequest {
  id         String      @id @default(uuid())
  employeeId String      @map("employee_id")
  leaveType  String      @map("leave_type") // annual, sick, personal, etc.
  startDate  DateTime    @map("start_date")
  endDate    DateTime    @map("end_date")
  reason     String?
  status     LeaveStatus @default(PENDING)
  reviewedBy String?     @map("reviewed_by")
  reviewedAt DateTime?   @map("reviewed_at")
  tenantId   String      @map("tenant_id")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  tenant   Tenant   @relation(fields: [tenantId], references: [id])

  @@index([employeeId])
  @@index([tenantId, status])
  @@map("leave_requests")
}

enum LeaveStatus {
  PENDING  @map("pending")
  APPROVED @map("approved")
  REJECTED @map("rejected")
}

model LeaveBalance {
  id         String   @id @default(uuid())
  employeeId String   @map("employee_id")
  leaveType  String   @map("leave_type")
  year       Int
  totalDays  Int      @default(0) @map("total_days")
  usedDays   Int      @default(0) @map("used_days")
  tenantId   String   @map("tenant_id")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  tenant   Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([employeeId, leaveType, year])
  @@index([employeeId])
  @@map("leave_balances")
}

// Supply Chain & Inventory

model Vendor {
  id        String   @id @default(uuid())
  name      String
  code      String // Vendor code
  email     String?
  phone     String?
  address   String?
  isActive  Boolean  @default(true)
  tenantId  String   @map("tenant_id")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products              Product[]
  purchaseOrders        PurchaseOrder[]
  inventoryTransactions InventoryTransaction[]

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([code, tenantId])
  @@map("vendors")
}

model Product {
  id               String   @id @default(uuid())
  name             String
  sku              String // Stock Keeping Unit
  description      String?
  unitPrice        Decimal  @map("unit_price") @db.Decimal(18, 2)
  unit             String   @default("ea") // ea, kg, lb, box, etc.
  reorderThreshold Int      @default(10) @map("reorder_threshold")
  isActive         Boolean  @default(true)
  tenantId         String   @map("tenant_id")
  vendorId         String?  @map("vendor_id")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  vendor                Vendor?                @relation(fields: [vendorId], references: [id])
  tenant                Tenant                 @relation(fields: [tenantId], references: [id])
  inventory             Inventory?
  purchaseOrderLines    PurchaseOrderLine[]
  inventoryTransactions InventoryTransaction[]

  @@unique([sku, tenantId])
  @@index([vendorId])
  @@map("products")
}

model Inventory {
  id        String   @id @default(uuid())
  productId String   @unique @map("product_id")
  quantity  Int      @default(0)
  tenantId  String   @map("tenant_id")
  updatedAt DateTime @updatedAt

  product      Product                @relation(fields: [productId], references: [id])
  tenant       Tenant                 @relation(fields: [tenantId], references: [id])
  transactions InventoryTransaction[]

  @@index([tenantId, quantity])
  @@map("inventory")
}

enum TransactionType {
  PURCHASE   @map("purchase")
  SALE       @map("sale")
  ADJUSTMENT @map("adjustment")
  RETURN     @map("return")
}

model InventoryTransaction {
  id          String          @id @default(uuid())
  productId   String          @map("product_id")
  inventoryId String          @map("inventory_id")
  vendorId    String?         @map("vendor_id")
  quantity    Int // Positive for additions, negative for deductions
  type        TransactionType
  reference   String? // PO number, SO number, etc.
  notes       String?
  tenantId    String          @map("tenant_id")
  createdAt   DateTime        @default(now())
  createdById String          @map("created_by_id")

  product   Product   @relation(fields: [productId], references: [id])
  inventory Inventory @relation(fields: [inventoryId], references: [id])
  vendor    Vendor?   @relation(fields: [vendorId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])

  @@index([productId])
  @@index([tenantId, createdAt])
  @@map("inventory_transactions")
}

enum PurchaseOrderStatus {
  DRAFT     @map("draft")
  PENDING   @map("pending")
  APPROVED  @map("approved")
  RECEIVED  @map("received")
  CANCELLED @map("cancelled")
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  orderNumber  String              @map("order_number")
  vendorId     String              @map("vendor_id")
  status       PurchaseOrderStatus @default(DRAFT)
  orderDate    DateTime            @default(now()) @map("order_date")
  expectedDate DateTime?           @map("expected_date")
  notes        String?
  totalAmount  Decimal?            @map("total_amount") @db.Decimal(18, 2)
  tenantId     String              @map("tenant_id")
  createdById  String              @map("created_by_id")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  vendor    Vendor              @relation(fields: [vendorId], references: [id])
  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  createdBy User                @relation(fields: [createdById], references: [id])
  lines     PurchaseOrderLine[]

  @@unique([orderNumber, tenantId])
  @@index([vendorId])
  @@index([tenantId, status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String   @id @default(uuid())
  purchaseOrderId String   @map("purchase_order_id")
  productId       String   @map("product_id")
  quantity        Int
  unitPrice       Decimal  @map("unit_price") @db.Decimal(18, 2)
  totalPrice      Decimal  @map("total_price") @db.Decimal(18, 2)
  receivedQty     Int      @default(0) @map("received_qty")
  tenantId        String   @map("tenant_id")
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])
  tenant        Tenant        @relation(fields: [tenantId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_lines")
}

// Notification Models

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String
  data      Json? // Additional notification data
  isRead    Boolean          @default(false) @map("is_read")
  tenantId  String           @map("tenant_id")
  createdAt DateTime         @default(now())
  readAt    DateTime?        @map("read_at")

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([userId])
  @@index([tenantId, createdAt])
  @@index([userId, isRead])
  @@map("notifications")
}

enum NotificationType {
  INFO    @map("info")
  WARNING @map("warning")
  ERROR   @map("error")
  SUCCESS @map("success")
  SYSTEM  @map("system")
}

model NotificationPreference {
  id                    String   @id @default(uuid())
  userId                String   @unique @map("user_id")
  emailEnabled          Boolean  @default(true) @map("email_enabled")
  pushEnabled           Boolean  @default(true) @map("push_enabled")
  inAppEnabled          Boolean  @default(true) @map("in_app_enabled")
  notifyOnLeaveRequest  Boolean  @default(true) @map("notify_on_leave_request")
  notifyOnPurchaseOrder Boolean  @default(true) @map("notify_on_purchase_order")
  notifyOnInventory     Boolean  @default(true) @map("notify_on_inventory")
  notifyOnSystem        Boolean  @default(true) @map("notify_on_system")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// Project Management Models

enum ProjectStatus {
  PLANNING  @map("planning")
  ACTIVE    @map("active")
  ON_HOLD   @map("on_hold")
  COMPLETED @map("completed")
  CANCELLED @map("cancelled")
}

enum TaskStatus {
  PENDING     @map("pending")
  IN_PROGRESS @map("in_progress")
  COMPLETED   @map("completed")
  BLOCKED     @map("blocked")
  CANCELLED   @map("cancelled")
}

enum TaskPriority {
  LOW    @map("low")
  MEDIUM @map("medium")
  HIGH   @map("high")
  URGENT @map("urgent")
}

enum MilestoneStatus {
  PENDING   @map("pending")
  COMPLETED @map("completed")
  OVERDUE   @map("overdue")
}

model Project {
  id          String        @id @default(uuid())
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?     @map("start_date")
  endDate     DateTime?     @map("end_date")
  isActive    Boolean       @default(true)
  tenantId    String        @map("tenant_id")
  createdById String        @map("created_by_id")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  createdBy  User           @relation(fields: [createdById], references: [id])
  tasks      Task[]
  milestones Milestone[]
  budget     ProjectBudget?

  @@unique([name, tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("projects")
}

model Task {
  id             String       @id @default(uuid())
  title          String
  description    String?
  status         TaskStatus   @default(PENDING)
  priority       TaskPriority @default(MEDIUM)
  startDate      DateTime?    @map("start_date")
  dueDate        DateTime?    @map("due_date")
  completedAt    DateTime?    @map("completed_at")
  estimatedHours Decimal?     @map("estimated_hours") @db.Decimal(10, 2)
  actualHours    Decimal?     @map("actual_hours") @db.Decimal(10, 2)
  projectId      String       @map("project_id")
  assigneeId     String?      @map("assignee_id")
  tenantId       String       @map("tenant_id")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee     User?            @relation(fields: [assigneeId], references: [id])
  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  dependencies TaskDependency[] @relation("DependentTask")
  dependents   TaskDependency[] @relation("PrerequisiteTask")

  @@index([projectId, status])
  @@index([assigneeId])
  @@index([tenantId, createdAt])
  @@map("tasks")
}

model TaskDependency {
  id                 String   @id @default(uuid())
  dependentTaskId    String   @map("dependent_task_id") // The task that depends on another
  prerequisiteTaskId String   @map("prerequisite_task_id") // The task that must be completed first
  createdAt          DateTime @default(now())

  dependentTask    Task @relation("DependentTask", fields: [dependentTaskId], references: [id], onDelete: Cascade)
  prerequisiteTask Task @relation("PrerequisiteTask", fields: [prerequisiteTaskId], references: [id], onDelete: Cascade)

  @@unique([dependentTaskId, prerequisiteTaskId])
  @@index([dependentTaskId])
  @@index([prerequisiteTaskId])
  @@map("task_dependencies")
}

model Milestone {
  id          String          @id @default(uuid())
  name        String
  description String?
  status      MilestoneStatus @default(PENDING)
  dueDate     DateTime?       @map("due_date")
  completedAt DateTime?       @map("completed_at")
  projectId   String          @map("project_id")
  tenantId    String          @map("tenant_id")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id])

  @@index([projectId])
  @@index([tenantId, status])
  @@map("milestones")
}

model ProjectBudget {
  id            String   @id @default(uuid())
  projectId     String   @unique @map("project_id")
  plannedAmount Decimal  @map("planned_amount") @db.Decimal(18, 2)
  actualAmount  Decimal  @default(0) @map("actual_amount") @db.Decimal(18, 2)
  currency      String   @default("USD")
  notes         String?
  tenantId      String   @map("tenant_id")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("project_budgets")
}

// Payroll Models
model PayrollRun {
  id             String        @id @default(uuid())
  period         String // e.g., "2026-04"
  currency       String        @default("USD")
  status         PayrollStatus @default(DRAFT)
  totalEmployees Int           @default(0) @map("total_employees")
  tenantId       String        @map("tenant_id")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  payslips Payslip[]

  @@index([tenantId, status])
  @@map("payroll_runs")
}

model Payslip {
  id           String        @id @default(uuid())
  runId        String        @map("run_id")
  employeeId   String        @map("employee_id")
  grossSalary  Decimal       @map("gross_salary") @db.Decimal(18, 2)
  taxDeduction Decimal       @default(0) @map("tax_deduction") @db.Decimal(18, 2)
  netSalary    Decimal       @map("net_salary") @db.Decimal(18, 2)
  status       PayslipStatus @default(DRAFT)
  tenantId     String        @map("tenant_id")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  run      PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee Employee   @relation(fields: [employeeId], references: [id])
  tenant   Tenant     @relation(fields: [tenantId], references: [id])

  @@index([runId])
  @@index([employeeId])
  @@map("payslips")
}

model TaxSlab {
  id          String   @id @default(uuid())
  minIncome   Int      @map("min_income")
  maxIncome   Int?     @map("max_income")
  rate        Float // Percentage
  fixedAmount Float    @default(0) @map("fixed_amount")
  tenantId    String   @map("tenant_id")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, minIncome])
  @@map("tax_slabs")
}

enum PayrollStatus {
  DRAFT
  PROCESSING
  APPROVED
  PAID
}

enum PayslipStatus {
  DRAFT
  APPROVED
  PAID
}

// Webhook Models
model WebhookSubscription {
  id        String   @id @default(uuid())
  url       String
  events    String[] // e.g., ["INVOICE_APPROVED", "PAYROLL_COMPLETE"]
  secret    String?
  isActive  Boolean  @default(true) @map("is_active")
  tenantId  String   @map("tenant_id")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  webhookDeliveries WebhookDelivery[]

  @@index([tenantId, isActive])
  @@map("webhook_subscriptions")
}

model WebhookDelivery {
  id             String         @id @default(uuid())
  subscriptionId String         @map("subscription_id")
  event          String
  payload        Json
  status         DeliveryStatus @default(PENDING)
  responseCode   Int?           @map("response_code")
  responseBody   String?        @map("response_body")
  attempts       Int            @default(0)
  lastAttemptAt  DateTime?      @map("last_attempt_at")
  tenantId       String         @map("tenant_id")
  createdAt      DateTime       @default(now())

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  tenant       Tenant              @relation(fields: [tenantId], references: [id])

  @@index([subscriptionId, status])
  @@map("webhook_deliveries")
}

enum DeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

// Report Models
model Report {
  id        String       @id @default(uuid())
  name      String
  type      String // e.g., "Financial", "Operations"
  schedule  String       @default("adhoc") // "daily", "weekly", "monthly", "adhoc"
  status    ReportStatus @default(PENDING)
  url       String?
  tenantId  String       @map("tenant_id")
  lastRun   DateTime?    @map("last_run")
  nextRun   DateTime?    @map("next_run")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, type])
  @@map("reports")
}

enum ReportStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
}
